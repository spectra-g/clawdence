{
  "$defs": {
    "ContractKind": {
      "description": "The four contracts v2.0 ships.\n\n``OUTSIDE_IN_TDD`` is one option among four rather than the welded-in\ndefault it was in v1 — 175 references to it inside the orchestrator is\nwhat made the process impossible to vary per work item.",
      "enum": [
        "outside-in-tdd",
        "test-after",
        "build-only",
        "none"
      ],
      "title": "ContractKind",
      "type": "string"
    },
    "FailingAssertion": {
      "additionalProperties": false,
      "description": "One failure, extracted from a reporter — not a stack trace dump.",
      "properties": {
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File"
        },
        "frames": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Frames",
          "type": "array"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "test_id": {
          "title": "Test Id",
          "type": "string"
        }
      },
      "required": [
        "test_id",
        "message"
      ],
      "title": "FailingAssertion",
      "type": "object"
    },
    "Shortfall": {
      "description": "Why a contract was not met — matchable, not prose.\n\n``VerificationResult.detail`` is for a person; this is what the retry\npolicy, the halt states and (later) S17's approval context branch on. The\nsame reasoning as ``StepError.kind``: a policy that has to regex an English\nsentence is one that breaks when somebody improves the wording.\n\nThe distinctions that earn their place are the ones handled differently.\n``NO_TEST_EVIDENCE`` and ``TESTS_FAILED`` are both \"the tests do not show\nthis works\" and both worth another attempt — but only the first can be\ncaused by a repository whose reporter is misconfigured, which is a fact\nabout the setup rather than about the code. ``NO_RED_PHASE`` and\n``VACUOUS_RED`` are the two ways outside-in TDD is faked, and they are\nseparate because the second one is a test that exists and asserts nothing,\nwhich is the more interesting failure to show a human.",
      "enum": [
        "no-tree",
        "runner-failed",
        "empty-diff",
        "pre-verify-failed",
        "build-failed",
        "no-test-evidence",
        "tests-failed",
        "partial-suite",
        "no-red-phase",
        "vacuous-red",
        "tests-removed"
      ],
      "title": "Shortfall",
      "type": "string"
    },
    "TestEvidence": {
      "additionalProperties": false,
      "description": "Structured result of a test run.",
      "properties": {
        "duration_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Seconds"
        },
        "failed": {
          "default": 0,
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "failures": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FailingAssertion"
          },
          "title": "Failures",
          "type": "array"
        },
        "passed": {
          "default": 0,
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "reporter": {
          "$ref": "#/$defs/TestReporter"
        },
        "skipped": {
          "default": 0,
          "minimum": 0,
          "title": "Skipped",
          "type": "integer"
        },
        "total": {
          "default": 0,
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "reporter"
      ],
      "title": "TestEvidence",
      "type": "object"
    },
    "TestReporter": {
      "description": "Machine-readable test output formats.\n\nDeclared per repo, consumed here. Raw stdout is not an option: a failing\nsuite emits thousands of lines, feeding them back exhausts the agent's\ncontext budget, and head/tail truncation drops the assertion the model\nactually needs — producing retry loops that burn to the cost cap without\never seeing the error.",
      "enum": [
        "junit-xml",
        "jest-json",
        "pytest-json-report",
        "go-test-json",
        "cargo-json",
        "none"
      ],
      "title": "TestReporter",
      "type": "string"
    },
    "VerificationContract": {
      "additionalProperties": false,
      "description": "A declaration of what counts as done, and what happens when it isn't.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ContractKind"
        },
        "max_attempts": {
          "default": 3,
          "maximum": 10,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "on_exhausted": {
          "const": "halt_to_human",
          "default": "halt_to_human",
          "title": "On Exhausted",
          "type": "string"
        },
        "pre_verify": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pre Verify"
        },
        "require_full_test_suite": {
          "default": false,
          "title": "Require Full Test Suite",
          "type": "boolean"
        },
        "require_non_empty_diff": {
          "default": true,
          "title": "Require Non Empty Diff",
          "type": "boolean"
        }
      },
      "required": [
        "kind"
      ],
      "title": "VerificationContract",
      "type": "object"
    }
  },
  "$id": "https://clawdence.dev/schemas/verification-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Evidence that a contract was met, bound to the tree it was met on.",
  "properties": {
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "contract": {
      "$ref": "#/$defs/VerificationContract"
    },
    "detail": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Detail"
    },
    "evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/TestEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "red_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/TestEvidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "shortfalls": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Shortfall"
      },
      "title": "Shortfalls",
      "type": "array"
    },
    "tree_hash": {
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$",
      "title": "Tree Hash",
      "type": "string"
    }
  },
  "required": [
    "contract",
    "passed",
    "tree_hash",
    "attempt",
    "checked_at"
  ],
  "title": "VerificationResult",
  "type": "object"
}
