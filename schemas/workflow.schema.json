{
  "$defs": {
    "AgentStage": {
      "additionalProperties": false,
      "description": "Invoke an LLM in a declared role.\n\nAgent steps are stateless: every execution starts from a clean context and\nall state lives in the store. v1 reset ``sessions.json`` before every spawn\nfor exactly this reason, and it is the single biggest reason its later\npipeline was more reliable than its earlier one.",
      "properties": {
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/Budget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "context_budget_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context Budget Tokens"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "max_turns": {
          "default": 1,
          "maximum": 32,
          "minimum": 1,
          "title": "Max Turns",
          "type": "integer"
        },
        "model": {
          "$ref": "#/$defs/ModelSelector"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "on_context_overflow": {
          "$ref": "#/$defs/ContextOverflowPolicy",
          "default": "fail"
        },
        "on_error": {
          "$ref": "#/$defs/OnError",
          "default": "fail"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "response_schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Schema"
        },
        "retry": {
          "$ref": "#/$defs/RetryPolicy",
          "default": {
            "backoff_seconds": 0.0,
            "max_attempts": 1
          }
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "salvage_partial_output": {
          "default": false,
          "title": "Salvage Partial Output",
          "type": "boolean"
        },
        "task": {
          "title": "Task",
          "type": "string"
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Seconds"
        },
        "tools": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tools",
          "type": "array"
        },
        "type": {
          "const": "agent",
          "default": "agent",
          "title": "Type",
          "type": "string"
        },
        "when": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "When"
        }
      },
      "required": [
        "id",
        "role",
        "task",
        "model"
      ],
      "title": "AgentStage",
      "type": "object"
    },
    "ApprovalStage": {
      "additionalProperties": false,
      "description": "Ask a human, and carry what they said into what happens next.",
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "on_error": {
          "$ref": "#/$defs/OnError",
          "default": "fail"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "require_different_approver": {
          "default": false,
          "title": "Require Different Approver",
          "type": "boolean"
        },
        "required_approver": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Approver"
        },
        "response_schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Schema"
        },
        "retry": {
          "$ref": "#/$defs/RetryPolicy",
          "default": {
            "backoff_seconds": 0.0,
            "max_attempts": 1
          }
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Seconds"
        },
        "timeout_seconds_override": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Seconds Override"
        },
        "type": {
          "const": "approval",
          "default": "approval",
          "title": "Type",
          "type": "string"
        },
        "when": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "When"
        }
      },
      "required": [
        "id",
        "prompt"
      ],
      "title": "ApprovalStage",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "description": "A cap on what one run, or one step, may spend.\n\nEvery limit is optional; ``None`` means unlimited on that axis. A budget\nwith every field ``None`` is legal and means \"no cap\" — which is a choice\nthe operator has to make explicitly rather than inherit.",
      "properties": {
        "max_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        },
        "max_usd": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Usd"
        },
        "max_wall_clock_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Wall Clock Seconds"
        },
        "on_exceeded": {
          "const": "abort",
          "default": "abort",
          "title": "On Exceeded",
          "type": "string"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "ContextOverflowPolicy": {
      "description": "What happens when an agent step exceeds its context budget.\n\nSilently dropping context is not an option. v1's whole Kimi failure class —\ntool calls emitted inside think blocks, sessions ending with no reply — was\ncontext growth across turns with no declared policy.",
      "enum": [
        "compact",
        "truncate",
        "fail"
      ],
      "title": "ContextOverflowPolicy",
      "type": "string"
    },
    "ForEachStage": {
      "additionalProperties": false,
      "description": "Run one pipeline for every value produced at runtime.\n\n``items`` is an exact ``$stage.json.path`` reference, rather than a string\ntemplate.  Keeping the value as JSON is what lets a decomposer return\nobjects and the branch read fields from them without a serialise/parse\nround-trip. ``serial_key`` is evaluated in the item context and limits one\nitem with the same key to be in flight at once; a repository id is the\nusual value, but the engine does not need repository knowledge.",
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "index_var": {
          "default": "index",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Index Var",
          "type": "string"
        },
        "item_var": {
          "default": "item",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Item Var",
          "type": "string"
        },
        "items": {
          "title": "Items",
          "type": "string"
        },
        "max_parallel": {
          "default": 1,
          "maximum": 64,
          "minimum": 1,
          "title": "Max Parallel",
          "type": "integer"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "on_error": {
          "$ref": "#/$defs/OnError",
          "default": "fail"
        },
        "retry": {
          "$ref": "#/$defs/RetryPolicy",
          "default": {
            "backoff_seconds": 0.0,
            "max_attempts": 1
          }
        },
        "serial_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Serial Key"
        },
        "stages": {
          "items": {
            "discriminator": {
              "mapping": {
                "agent": "#/$defs/AgentStage",
                "approval": "#/$defs/ApprovalStage",
                "for_each": "#/$defs/ForEachStage",
                "parallel": "#/$defs/ParallelStage",
                "repeat": "#/$defs/RepeatStage",
                "runner": "#/$defs/RunnerStage",
                "script": "#/$defs/ScriptStage",
                "workflow": "#/$defs/SubWorkflowStage"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ScriptStage"
              },
              {
                "$ref": "#/$defs/AgentStage"
              },
              {
                "$ref": "#/$defs/RunnerStage"
              },
              {
                "$ref": "#/$defs/ApprovalStage"
              },
              {
                "$ref": "#/$defs/ForEachStage"
              },
              {
                "$ref": "#/$defs/ParallelStage"
              },
              {
                "$ref": "#/$defs/SubWorkflowStage"
              },
              {
                "$ref": "#/$defs/RepeatStage"
              }
            ]
          },
          "minItems": 1,
          "title": "Stages",
          "type": "array"
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Seconds"
        },
        "type": {
          "const": "for_each",
          "default": "for_each",
          "title": "Type",
          "type": "string"
        },
        "when": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "When"
        }
      },
      "required": [
        "id",
        "items",
        "stages"
      ],
      "title": "ForEachStage",
      "type": "object"
    },
    "JsonValue": {},
    "ModelCapability": {
      "enum": [
        "tool_calling",
        "structured_output",
        "long_context",
        "vision"
      ],
      "title": "ModelCapability",
      "type": "string"
    },
    "ModelSelector": {
      "additionalProperties": false,
      "description": "Which model runs a step, and what it must be able to do.\n\nModel is per *step*, not per agent — v1 pinned it per agent in\n``openclaw.json``, so changing one role's model changed it everywhere that\nrole appeared.\n\n``requires`` exists so a model swap fails validation rather than failing\nmysteriously at run time. ``temperature`` and ``seed`` are pinned so the\neval harness measures prompt changes rather than sampling noise.",
      "properties": {
        "fallbacks": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Fallbacks",
          "type": "array"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "requires": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ModelCapability"
          },
          "title": "Requires",
          "type": "array"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 2,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        }
      },
      "required": [
        "model"
      ],
      "title": "ModelSelector",
      "type": "object"
    },
    "OnError": {
      "description": "What a stage failure does to the run.",
      "enum": [
        "fail",
        "continue",
        "skip_rest"
      ],
      "title": "OnError",
      "type": "string"
    },
    "ParallelBranch": {
      "additionalProperties": false,
      "description": "One named branch in a static parallel barrier.",
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "stages": {
          "items": {
            "discriminator": {
              "mapping": {
                "agent": "#/$defs/AgentStage",
                "approval": "#/$defs/ApprovalStage",
                "for_each": "#/$defs/ForEachStage",
                "parallel": "#/$defs/ParallelStage",
                "repeat": "#/$defs/RepeatStage",
                "runner": "#/$defs/RunnerStage",
                "script": "#/$defs/ScriptStage",
                "workflow": "#/$defs/SubWorkflowStage"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ScriptStage"
              },
              {
                "$ref": "#/$defs/AgentStage"
              },
              {
                "$ref": "#/$defs/RunnerStage"
              },
              {
                "$ref": "#/$defs/ApprovalStage"
              },
              {
                "$ref": "#/$defs/ForEachStage"
              },
              {
                "$ref": "#/$defs/ParallelStage"
              },
              {
                "$ref": "#/$defs/SubWorkflowStage"
              },
              {
                "$ref": "#/$defs/RepeatStage"
              }
            ]
          },
          "minItems": 1,
          "title": "Stages",
          "type": "array"
        }
      },
      "required": [
        "id",
        "stages"
      ],
      "title": "ParallelBranch",
      "type": "object"
    },
    "ParallelStage": {
      "additionalProperties": false,
      "description": "Run declared branches concurrently, then expose one joined result.",
      "properties": {
        "branches": {
          "items": {
            "$ref": "#/$defs/ParallelBranch"
          },
          "minItems": 1,
          "title": "Branches",
          "type": "array"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "max_parallel": {
          "default": 64,
          "maximum": 64,
          "minimum": 1,
          "title": "Max Parallel",
          "type": "integer"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "on_error": {
          "$ref": "#/$defs/OnError",
          "default": "fail"
        },
        "retry": {
          "$ref": "#/$defs/RetryPolicy",
          "default": {
            "backoff_seconds": 0.0,
            "max_attempts": 1
          }
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Seconds"
        },
        "type": {
          "const": "parallel",
          "default": "parallel",
          "title": "Type",
          "type": "string"
        },
        "when": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "When"
        }
      },
      "required": [
        "id",
        "branches"
      ],
      "title": "ParallelStage",
      "type": "object"
    },
    "RepeatStage": {
      "additionalProperties": false,
      "description": "Repeat a pipeline until its post-iteration condition becomes true.\n\nThe current one-based counter is ``$iteration.json`` and the preceding\niteration's stage outputs are ``$previous.json.<stage>``. Exhausting the\nbound is always a failure: a configurable force-proceed path would make a\nretry cap decorative.",
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "max_iterations": {
          "maximum": 32,
          "minimum": 1,
          "title": "Max Iterations",
          "type": "integer"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "on_error": {
          "$ref": "#/$defs/OnError",
          "default": "fail"
        },
        "on_exhausted": {
          "const": "fail",
          "default": "fail",
          "title": "On Exhausted",
          "type": "string"
        },
        "retry": {
          "$ref": "#/$defs/RetryPolicy",
          "default": {
            "backoff_seconds": 0.0,
            "max_attempts": 1
          }
        },
        "stages": {
          "items": {
            "discriminator": {
              "mapping": {
                "agent": "#/$defs/AgentStage",
                "approval": "#/$defs/ApprovalStage",
                "for_each": "#/$defs/ForEachStage",
                "parallel": "#/$defs/ParallelStage",
                "repeat": "#/$defs/RepeatStage",
                "runner": "#/$defs/RunnerStage",
                "script": "#/$defs/ScriptStage",
                "workflow": "#/$defs/SubWorkflowStage"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ScriptStage"
              },
              {
                "$ref": "#/$defs/AgentStage"
              },
              {
                "$ref": "#/$defs/RunnerStage"
              },
              {
                "$ref": "#/$defs/ApprovalStage"
              },
              {
                "$ref": "#/$defs/ForEachStage"
              },
              {
                "$ref": "#/$defs/ParallelStage"
              },
              {
                "$ref": "#/$defs/SubWorkflowStage"
              },
              {
                "$ref": "#/$defs/RepeatStage"
              }
            ]
          },
          "minItems": 1,
          "title": "Stages",
          "type": "array"
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Seconds"
        },
        "type": {
          "const": "repeat",
          "default": "repeat",
          "title": "Type",
          "type": "string"
        },
        "until": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Until",
          "type": "string"
        },
        "when": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "When"
        }
      },
      "required": [
        "id",
        "stages",
        "until",
        "max_iterations"
      ],
      "title": "RepeatStage",
      "type": "object"
    },
    "RetryPolicy": {
      "additionalProperties": false,
      "properties": {
        "backoff_seconds": {
          "default": 0.0,
          "minimum": 0,
          "title": "Backoff Seconds",
          "type": "number"
        },
        "max_attempts": {
          "default": 1,
          "maximum": 10,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        }
      },
      "title": "RetryPolicy",
      "type": "object"
    },
    "RunnerStage": {
      "additionalProperties": false,
      "description": "Execute repo code in the data plane.",
      "properties": {
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/Budget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "isolation_tier_override": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Isolation Tier Override"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "on_error": {
          "$ref": "#/$defs/OnError",
          "default": "fail"
        },
        "plan": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan"
        },
        "retry": {
          "$ref": "#/$defs/RetryPolicy",
          "default": {
            "backoff_seconds": 0.0,
            "max_attempts": 1
          }
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Seconds"
        },
        "type": {
          "const": "runner",
          "default": "runner",
          "title": "Type",
          "type": "string"
        },
        "when": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
